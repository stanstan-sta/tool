{
  "schemaVersion": 1,
  "id": "mindcraft-bridge",
  "version": "${version}",
  "name": "Mindcraft Bridge",
  "description": "HTTP bridge that lets the Mindcraft LLM agent control this Fabric client. Exposes /state, /command, /ping on localhost:8765.",
  "authors": [ "stanstan-sta" ],
  "contact": { "sources": "https://github.com/stanstan-sta/tool" },
  "license": "MIT",
  "icon": "assets/mindcraft-bridge/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [ "com.mindcraft.bridge.MindcraftBridgeMod" ]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft":    "~1.21.1",
    "java":         ">=21",
    "fabric-api":   "*"
  },
  "suggests": {
    "baritone": "*"
  }
}

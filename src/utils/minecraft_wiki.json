  "mechanics": {
    "cooking": {
      "description": "Cooking transforms raw food into cooked food using a furnace or smoker.",
      "formula": "raw_food + fuel -> cooked_food (in furnace/smoker)",
      "examples": [
        "raw_beef + coal -> cooked_beef (furnace)",
        "raw_chicken + charcoal -> cooked_chicken (furnace)",
        "raw_porkchop + wood -> cooked_porkchop (furnace)"
